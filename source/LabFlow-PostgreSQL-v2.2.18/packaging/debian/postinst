#!/bin/sh
set -eu

if ! getent group labflow >/dev/null 2>&1; then
    addgroup --system labflow >/dev/null
fi
if ! getent passwd labflow >/dev/null 2>&1; then
    adduser --system --ingroup labflow --home /var/lib/labflow --no-create-home --disabled-login --disabled-password labflow >/dev/null
fi

install -d -o labflow -g labflow -m 0750 /var/lib/labflow
install -d -o root -g labflow -m 0750 /etc/labflow
if [ ! -f /etc/labflow/config.toml ]; then
    install -o root -g labflow -m 0640 /opt/labflow/config.example.toml /etc/labflow/config.toml
fi
if [ ! -f /etc/labflow/labflow.env ]; then
    cat >/etc/labflow/labflow.env <<'EOF'
# Required: set a PostgreSQL connection string before first start.
DATABASE_URL=postgresql://workload_app:change_me@127.0.0.1:5432/workload_tool
# Required on a new install; keep this file mode 0600.
ADMIN_PASSWORD=change_me
EOF
    chown root:labflow /etc/labflow/labflow.env
    chmod 0600 /etc/labflow/labflow.env
fi

chown -R root:labflow /opt/labflow
chmod 0755 /opt/labflow/bin/workload-tool
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload
    systemctl enable labflow.service >/dev/null
    systemctl restart labflow.service || true
fi
exit 0
